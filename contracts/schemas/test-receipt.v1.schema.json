{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/contracts/schemas/test-receipt.v1.schema.json",
  "title": "TestReceipt",
  "description": "机器可读测试回执，至少包含测试 ID、环境 manifest 摘要、动作、期望、实际状态、外部副作用计数、Artifact 摘要和最终 receipt。禁止手工文字改为成功。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId", "testId", "environmentManifestDigest",
    "actions", "expected", "actual", "sideEffectCount",
    "artifactDigests", "result", "createdAt"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "description": "回执唯一 ID"
    },
    "testId": {
      "type": "string",
      "minLength": 1,
      "description": "测试 ID（来自 required-test-catalog.v1.json）"
    },
    "environmentManifestDigest": {
      "type": "string",
      "minLength": 1,
      "description": "环境 Compatibility Manifest 摘要"
    },
    "actions": {
      "type": "array",
      "description": "执行动作列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionId", "description", "executedAt"],
        "properties": {
          "actionId": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "inputDigest": {"type": "string", "minLength": 1},
          "executedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "expected": {
      "type": "object",
      "description": "期望结果描述（机器可读）"
    },
    "actual": {
      "type": "object",
      "description": "实际观察结果（机器可读）"
    },
    "sideEffectCount": {
      "type": "integer",
      "minimum": 0,
      "description": "外部副作用计数"
    },
    "artifactDigests": {
      "type": "array",
      "description": "相关 Artifact 摘要列表",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED_UNCERTIFIED"],
      "description": "测试结论（不能通过手工文字改为 PASS）"
    },
    "failureReason": {
      "type": "string",
      "description": "失败原因（result=FAIL 时必填）"
    },
    "scenarioContractDigest": {
      "type": "string",
      "minLength": 1,
      "description": "场景合同内容摘要（来自 required-test-catalog）"
    },
    "implementationContributors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "实现贡献者列表"
    },
    "finalPassOwner": {
      "type": "string",
      "minLength": 1,
      "description": "最终通过责任人"
    },
    "requiredReplays": {
      "type": "integer",
      "minimum": 0,
      "description": "要求重放次数"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "回执创建时间"
    }
  }
}
