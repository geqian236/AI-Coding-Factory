{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/contracts/schemas/prepared-batch.v2.schema.json",
  "title": "PreparedBatchV2",
  "description": "预备事件批次 manifest（§10.1 + §11）。由不可变 manifest + 一个或多个自描述脱敏 stream segment 组成。manifest 至少含 preparedBatchId、按 batchOrdinal 排列的全量稳定 ingestEventId、每个 Task 唯一的 expectedCommittedHead 与 ordinal 范围、segment digest 列表、总事件数/长度、schema/coordinator 版本、完整尾标。跨 Task 事件可交错；同一 Task 至多一个未提交批次。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparedBatchId",
    "writerEpoch",
    "state",
    "orderedIngestIds",
    "perTaskExpectedHeads",
    "segmentDigests",
    "eventCount",
    "payloadBytes",
    "firstBatchOrdinal",
    "lastBatchOrdinal",
    "oldestIngestedAt",
    "preparedAt",
    "schemaVersion",
    "coordinatorVersion"
  ],
  "properties": {
    "preparedBatchId": {
      "type": "string",
      "minLength": 1,
      "description": "批次唯一稳定 ID。"
    },
    "writerEpoch": {
      "type": "integer",
      "minimum": 0,
      "description": "claim 时的 writer epoch（用于竞争检测）。"
    },
    "state": {
      "type": "string",
      "enum": ["CLAIMED", "PREPARING", "PREPARED", "COMMITTED"],
      "description": "批次状态机（§11 ingest_batches）。正常转换仅 CLAIMED → PREPARING → PREPARED → COMMITTED；旧 epoch pre-commit 状态只能由 Reconciler CAS 为 ABANDONED。COMMITTED/ABANDONED 均为终态。"
    },
    "orderedIngestIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "按 batchOrdinal 排列的全量稳定 ingestEventId 列表（权威顺序）。"
    },
    "perTaskExpectedHeads": {
      "type": "array",
      "minItems": 1,
      "description": "每个 Task 唯一的 expectedCommittedHead 锚点 + 批内 ordinal 范围（§11 ingest_batch_task_heads）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "expectedTaskSeq",
          "expectedEventDigest",
          "firstBatchOrdinal",
          "lastBatchOrdinal"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "expectedTaskSeq": {
            "type": "integer",
            "minimum": 0,
            "description": "该 Task 锚点处的 taskSeq（CAS 重放基线）。"
          },
          "expectedEventDigest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[a-f0-9]{64}$|^$",
            "description": "该 Task 锚点处的 eventDigest（genesis 为 null 或全零 predecessor）。"
          },
          "firstBatchOrdinal": {
            "type": "integer",
            "minimum": 0,
            "description": "该 Task 在本批内的首事件 batchOrdinal。"
          },
          "lastBatchOrdinal": {
            "type": "integer",
            "minimum": 0,
            "description": "该 Task 在本批内的末事件 batchOrdinal。"
          }
        }
      }
    },
    "segmentDigests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segmentId",
          "taskId",
          "runId",
          "attemptId",
          "streamId",
          "ordinalRange",
          "mappingPrecision",
          "sourceSpan",
          "sanitizedSpan",
          "contentDigest",
          "redactionManifestDigest",
          "predecessorDigest",
          "completeFooterDigest",
          "adapterVersion"
        ],
        "description": "stream segment 自描述结构（§10.4）。header/footer 包含 batch ID/manifest digest、Task/Run/Attempt/stream 身份、所含 ordinal 范围、按 mappingPrecision 最小化的来源跨度与精确脱敏跨度、内容/redaction manifest digest、adapter 版本、来源水位和完整尾标。",
        "properties": {
          "segmentId": {"type": "string", "minLength": 1},
          "taskId": {"type": "string", "minLength": 1},
          "runId": {"type": "string", "minLength": 1},
          "attemptId": {"type": "string", "minLength": 1},
          "streamId": {"type": ["string", "null"]},
          "ordinalRange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "lastExclusive"],
            "properties": {
              "first": {"type": "integer", "minimum": 0},
              "lastExclusive": {"type": "integer", "minimum": 1}
            }
          },
          "mappingPrecision": {
            "type": "string",
            "enum": ["byte", "field", "frame", "none"]
          },
          "sourceSpan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "endExclusive"],
            "properties": {
              "start": {"type": ["integer", "null"], "minimum": 0},
              "endExclusive": {"type": ["integer", "null"], "minimum": 0}
            }
          },
          "sanitizedSpan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "endExclusive"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "endExclusive": {"type": "integer", "minimum": 0}
            }
          },
          "contentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "redactionManifestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "predecessorDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "completeFooterDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "adapterVersion": {"type": "string"}
        }
      },
      "description": "segment digest 列表。"
    },
    "eventCount": {
      "type": "integer",
      "minimum": 1,
      "description": "总事件数。"
    },
    "payloadBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "总 payload 字节数。"
    },
    "firstBatchOrdinal": {
      "type": "integer",
      "minimum": 0,
      "description": "本批首事件 batchOrdinal。"
    },
    "lastBatchOrdinal": {
      "type": "integer",
      "minimum": 0,
      "description": "本批末事件 batchOrdinal。"
    },
    "oldestIngestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "本批最旧 ingestedAt。"
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time",
      "description": "本批 prepared 完成时间。"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "PreparedBatch schema 版本。"
    },
    "coordinatorVersion": {
      "type": "string",
      "description": "coordinator 版本（compatibility manifest 绑定）。"
    }
  }
}