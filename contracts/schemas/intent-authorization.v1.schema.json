{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/contracts/schemas/intent-authorization.v1.schema.json",
  "title": "IntentAuthorization",
  "description": "Phase 1 v1 设计决定：IntentAuthorization 只冻结可解析、可重算的闭合快照引用、用户包络和有限预算，不携带 PlanRevision、semanticPlanHash 或 planRevisionDigest。Task 4 Policy Engine 必须从 COMMITTED 不可变 artifact 解析每个 ref，核验 schema/version/validator 并重算 digest；裸 digest 或任一漂移均不是充分证据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intentAuthorizationId",
    "taskId",
    "userId",
    "requirementDigest",
    "projectId",
    "repositoryId",
    "repositoryBindingDigest",
    "baselineDigest",
    "targetStage",
    "stageCapabilityMapVersion",
    "allowedCapabilitySetDigest",
    "targetBindingDigest",
    "riskCeiling",
    "estimatedCostAlertDigest",
    "autonomousExecutionBudgetMs",
    "repairLoopLimit",
    "autoReplanLimit",
    "attemptLimit",
    "issuedAt",
    "expiresAt",
    "revokedAt",
    "revokeReason"
  ],
  "properties": {
    "intentAuthorizationId": {
      "type": "string",
      "minLength": 1,
      "description": "IntentAuthorization 的稳定身份。"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "被授权任务的稳定身份。"
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "description": "做出一次性授权的用户身份。"
    },
    "requirementDigest": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/snapshotRef"},
        {"properties": {"schemaId": {"const": "factory.authorization.intent.requirement.v1"}, "schemaVersion": {"const": "1"}}}
      ],
      "xSnapshotRegistryEntry": "IntentAuthorization.requirementDigest",
      "description": "规范化用户需求的闭合 JCS/NFC 快照引用。"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "description": "项目身份，禁止跨项目复用授权。"
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "description": "规范化后的仓库身份。"
    },
    "repositoryBindingDigest": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/snapshotRef"},
        {"properties": {"schemaId": {"const": "factory.authorization.intent.repository-binding.v1"}, "schemaVersion": {"const": "1"}}}
      ],
      "xSnapshotRegistryEntry": "IntentAuthorization.repositoryBindingDigest",
      "description": "可解析的仓库/物理路径/模式绑定快照引用。"
    },
    "baselineDigest": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/snapshotRef"},
        {"properties": {"schemaId": {"const": "factory.authorization.intent.baseline.v1"}, "schemaVersion": {"const": "1"}}}
      ],
      "xSnapshotRegistryEntry": "IntentAuthorization.baselineDigest",
      "description": "可解析的基础分支、base SHA 或 bootstrap 前置事实快照引用。"
    },
    "targetStage": {
      "type": "string",
      "enum": [
        "DESIGN_APPROVED",
        "CODEX_APPROVED",
        "PR_READY",
        "MERGED",
        "STAGING_ACCEPTED",
        "PRODUCTION_ACCEPTED"
      ],
      "description": "用户选择的目标终点阶段；只给出 capability 上限。"
    },
    "stageCapabilityMapVersion": {
      "type": "string",
      "minLength": 1,
      "description": "派生授权时使用的 stage-capability-map 版本。"
    },
    "allowedCapabilitySetDigest": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/snapshotRef"},
        {"properties": {"schemaId": {"const": "factory.authorization.intent.allowed-capability-set.v1"}, "schemaVersion": {"const": "1"}}}
      ],
      "xSnapshotRegistryEntry": "IntentAuthorization.allowedCapabilitySetDigest",
      "description": "targetStage 展开后的排序 capability 集合快照引用。"
    },
    "targetBindingDigest": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/snapshotRef"},
        {"properties": {"schemaId": {"const": "factory.authorization.intent.target-binding.v1"}, "schemaVersion": {"const": "1"}}}
      ],
      "xSnapshotRegistryEntry": "IntentAuthorization.targetBindingDigest",
      "description": "可解析的环境、ServerProfile、数据库和资源目标绑定快照引用。"
    },
    "riskCeiling": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "用户接受的最高风险等级。"
    },
    "estimatedCostAlertDigest": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/snapshotRef"},
        {"properties": {"schemaId": {"const": "factory.authorization.intent.estimated-cost-alert.v1"}, "schemaVersion": {"const": "1"}}}
      ],
      "xSnapshotRegistryEntry": "IntentAuthorization.estimatedCostAlertDigest",
      "description": "可解析的估算成本告警策略快照引用；不把订阅 CLI 估算伪装成真实账单。"
    },
    "autonomousExecutionBudgetMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "端到端自主执行预算（毫秒）；禁止无限值。"
    },
    "repairLoopLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "自动修复轮数上限。"
    },
    "autoReplanLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "自动重规划次数上限。"
    },
    "attemptLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Attempt 总数上限。"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "description": "授权签发时间。"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "绝对有效期；暂停不会延长它。"
    },
    "revokedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "撤销时间；未撤销时显式为 null。"
    },
    "revokeReason": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "撤销原因；未撤销时显式为 null。"
    }
  },
  "$defs": {
    "snapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "schemaId", "schemaVersion", "digest"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "schemaId": {"type": "string", "minLength": 1},
        "schemaVersion": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"revokedAt": {"type": "null"}}},
      "then": {"properties": {"revokeReason": {"type": "null"}}},
      "else": {"properties": {"revokeReason": {"type": "string", "minLength": 1}}}
    }
  ]
}
