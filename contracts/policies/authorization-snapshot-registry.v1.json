{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/contracts/policies/authorization-snapshot-registry.v1.json",
  "title": "AuthorizationSnapshotRegistryV1",
  "description": "授权摘要快照的闭合集合。每个引用都先以 artifactId 定位不可变对象，再以固定 schemaId/schemaVersion 和域分离摘要证明其 payload；Task 4 必须按本 registry 解析、校验并重算，不能把裸 digest 当作授权证据。",
  "version": "1",
  "canonicalizer": {
    "unicodeNormalization": "NFC",
    "serialization": "RFC8785/JCS",
    "digestAlgorithm": "sha256",
    "domainSeparatedInput": "[schemaId,schemaVersion,payload]",
    "digestExpression": "sha256(JCS/NFC([schemaId,schemaVersion,payload]))"
  },
  "snapshotRefSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["artifactId", "schemaId", "schemaVersion", "digest"],
    "properties": {
      "artifactId": {
        "type": "string",
        "minLength": 1,
        "description": "COMMITTED 不可变 artifact 的稳定定位符；它不参与 payload digest 输入。"
      },
      "schemaId": {
        "type": "string",
        "minLength": 1,
        "description": "快照 payload 的固定 schema 身份。"
      },
      "schemaVersion": {
        "type": "string",
        "minLength": 1,
        "description": "快照 payload 的固定 schema 版本。"
      },
      "digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$",
        "description": "sha256(JCS/NFC([schemaId,schemaVersion,payload]))。"
      }
    }
  },
  "artifactResolution": {
    "requiredState": "COMMITTED",
    "immutable": true,
    "mustResolveArtifactId": true,
    "mustMatch": [
      "schemaId",
      "schemaVersion",
      "validatorSource",
      "recomputedDigest"
    ],
    "rejectOnMismatch": true
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nodeType": {
      "type": "string",
      "enum": [
        "PLAN", "DESIGN_REVIEW", "BOOTSTRAP_REPOSITORY", "IMPLEMENT",
        "VERIFY", "CODE_REVIEW", "ATTEST_REVIEW", "PUBLISH_PR", "MERGE",
        "BUILD_ARTIFACT", "DEPLOY_STAGING", "ACCEPT_STAGING",
        "DEPLOY_PRODUCTION", "ACCEPT_PRODUCTION", "ROLLBACK",
        "RECONCILE_TARGET", "RESTORE_DRILL"
      ]
    },
    "actionCapability": {
      "type": "string",
      "enum": [
        "acceptance.fixture.write", "build.exec.isolated", "check.publish", "container.inspect.scoped",
        "db.backup", "db.check", "db.migrate", "db.read", "db.restore", "forge.observe.scoped",
        "git.local_commit", "git.push", "http.check.scoped", "log.read.scoped", "network.egress.scoped",
        "nginx.switch", "pr.create", "pr.update", "registry.observe.scoped", "registry.push",
        "remote.observe.scoped", "remote.write.scoped", "repo.bootstrap", "repo.merge", "repo.read",
        "restore.validation.instance", "rollback", "service.restart.scoped", "ssh.exec.scoped",
        "target.guard.clear", "test.exec.isolated", "traffic.switch.scoped", "worktree.write"
      ]
    },
    "targetStage": {
      "type": "string",
      "enum": [
        "DESIGN_APPROVED", "CODEX_APPROVED", "PR_READY", "MERGED",
        "STAGING_ACCEPTED", "PRODUCTION_ACCEPTED"
      ]
    },
    "intentRequirementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementText", "normalizationVersion"],
      "properties": {
        "requirementText": {"$ref": "#/$defs/nonEmptyString"},
        "normalizationVersion": {"const": "nfc-jcs-v1"},
        "attachmentsDigest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "repositoryBindingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "canonicalRemote", "physicalRootIdentity", "mode"],
      "properties": {
        "repositoryId": {"$ref": "#/$defs/nonEmptyString"},
        "canonicalRemote": {"$ref": "#/$defs/nonEmptyString"},
        "physicalRootIdentity": {"$ref": "#/$defs/nonEmptyString"},
        "mode": {"enum": ["existing", "new"]},
        "baseBranch": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "baselinePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseBranch", "baseSha", "bootstrapState"],
      "properties": {
        "baseBranch": {"$ref": "#/$defs/nonEmptyString"},
        "baseSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "bootstrapState": {"enum": ["EXISTS", "BOOTSTRAP_REQUIRED"]},
        "bootstrapReceiptId": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "allowedCapabilitySetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetStage", "capabilities"],
      "properties": {
        "targetStage": {"$ref": "#/$defs/targetStage"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/actionCapability"}
        }
      }
    },
    "targetBindingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetKind", "projectId"],
      "properties": {
        "targetKind": {"enum": ["repository", "environment", "deployment-target"]},
        "projectId": {"$ref": "#/$defs/nonEmptyString"},
        "environment": {"enum": ["STAGING", "PRODUCTION"]},
        "serverProfileId": {"$ref": "#/$defs/nonEmptyString"},
        "databaseProfileId": {"$ref": "#/$defs/nonEmptyString"},
        "registryProfileId": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "estimatedCostAlertPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "alertThreshold", "hardStopThreshold"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "alertThreshold": {"type": "number", "minimum": 0},
        "hardStopThreshold": {"type": "number", "minimum": 0},
        "billingScope": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "semanticPlanPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "字段集合与 factory_agent.policy.plan_hash.build_semantic_projection 的 RunSpec 语义投影严格同源。",
      "required": [
        "schemaVersion",
        "goal",
        "assumptions",
        "scope",
        "constraints",
        "acceptanceCriteria",
        "targetStage",
        "riskProfile",
        "nodeCapabilityMapVersion",
        "stageCapabilityMapVersion",
        "repository",
        "workPlan"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "RunSpec schema 版本号"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "用户目标的结构化表达"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "规划假设列表"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude"],
          "description": "范围声明（§8：include/exclude）",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "纳入范围的路径/模块"
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "排除范围的路径/模块"
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "约束条件列表"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "验收条件列表"
        },
        "targetStage": {
          "type": "string",
          "enum": [
            "DESIGN_APPROVED",
            "CODEX_APPROVED",
            "PR_READY",
            "MERGED",
            "STAGING_ACCEPTED",
            "PRODUCTION_ACCEPTED"
          ],
          "description": "目标终点阶段（Master Spec §6.1 权威 6 阶段）"
        },
        "riskProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "reasons"],
          "description": "风险画像（§8：level/reasons）",
          "properties": {
            "level": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"],
              "description": "风险等级"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "风险原因列表"
            }
          }
        },
        "nodeCapabilityMapVersion": {
          "type": "string",
          "minLength": 1,
          "description": "node-capability-map 版本标识"
        },
        "stageCapabilityMapVersion": {
          "type": "string",
          "minLength": 1,
          "description": "stage-capability-map 版本标识"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "root", "baseBranch", "baseCommit"],
          "description": "仓库绑定（§8：mode/root/baseBranch/baseCommit；baseCommit 键始终存在，bootstrap 前仅允许 new/null）",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["existing", "new"],
              "description": "仓库模式"
            },
            "root": {
              "type": "string",
              "minLength": 1,
              "description": "规范化后的 D 盘仓库根路径"
            },
            "baseBranch": {
              "type": "string",
              "minLength": 1,
              "description": "基础分支名"
            },
            "baseCommit": {
              "type": ["string", "null"],
              "description": "可信 base commit：existing 必须为 40 位小写 SHA；bootstrap 前的 new 必须为 null"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"mode": {"const": "existing"}},
                "required": ["mode"]
              },
              "then": {
                "properties": {
                  "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                }
              }
            },
            {
              "if": {
                "properties": {"mode": {"const": "new"}},
                "required": ["mode"]
              },
              "then": {
                "properties": {
                  "baseCommit": {"type": "null"}
                }
              }
            }
          ]
        },
        "workPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dagVersion", "nodes", "barriers"],
          "description": "工作计划 DAG（§8：dagVersion/nodes/barriers）",
          "properties": {
            "dagVersion": {
              "type": "integer",
              "minimum": 1,
              "description": "DAG 结构版本"
            },
            "nodes": {
              "type": "array",
              "description": "DAG 工作节点列表",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "logicalNodeId",
                  "businessPhase",
                  "barrierOrdinal",
                  "nodeType",
                  "required",
                  "dependsOn",
                  "sideEffectClass",
                  "requiredArtifacts",
                  "successPredicateId",
                  "timeoutMs",
                  "retryPolicyId"
                ],
                "properties": {
                  "logicalNodeId": {"type": "string", "minLength": 1},
                  "businessPhase": {"type": "string", "minLength": 1},
                  "barrierOrdinal": {"type": "integer", "minimum": 0},
                  "nodeType": {
                    "type": "string",
                    "enum": [
                      "PLAN", "DESIGN_REVIEW", "BOOTSTRAP_REPOSITORY", "IMPLEMENT",
                      "VERIFY", "CODE_REVIEW", "ATTEST_REVIEW", "PUBLISH_PR", "MERGE",
                      "BUILD_ARTIFACT", "DEPLOY_STAGING", "ACCEPT_STAGING",
                      "DEPLOY_PRODUCTION", "ACCEPT_PRODUCTION", "ROLLBACK",
                      "RECONCILE_TARGET", "RESTORE_DRILL"
                    ]
                  },
                  "required": {"type": "boolean"},
                  "dependsOn": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "sideEffectClass": {"type": "string", "minLength": 1},
                  "requiredArtifacts": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "successPredicateId": {"type": "string", "minLength": 1},
                  "timeoutMs": {"type": "integer", "minimum": 1},
                  "retryPolicyId": {"type": "string", "minLength": 1}
                }
              }
            },
            "barriers": {
              "type": "array",
              "description": "阶段屏障列表",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "businessPhase",
                  "barrierOrdinal",
                  "requiredNodeIds",
                  "settleTimeoutMs",
                  "passPredicateId"
                ],
                "properties": {
                  "businessPhase": {"type": "string", "minLength": 1},
                  "barrierOrdinal": {"type": "integer", "minimum": 0},
                  "requiredNodeIds": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "settleTimeoutMs": {"type": "integer", "minimum": 1},
                  "passPredicateId": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "planRevisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "字段类型和 required 集合逐项派生自 plan-revision.v1.schema.json；摘要 material 只排除自身值与签名。",
      "required": [
        "planRevisionId",
        "taskId",
        "specRevision",
        "intentAuthorizationId",
        "semanticPlanHash",
        "dagVersion",
        "nodeCapabilityMapVersion",
        "stageCapabilityMapVersion",
        "nodes",
        "barriers",
        "stageMaps",
        "createdAt"
      ],
      "properties": {
        "planRevisionId": {
          "type": "string",
          "minLength": 1,
          "description": "本修订版本唯一 ID"
        },
        "parentRevisionId": {
          "type": "string",
          "minLength": 1,
          "description": "父修订版本 ID（范围内重规划时设置）"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "description": "所属任务 ID（§11 plan_revisions.task_id）"
        },
        "specRevision": {
          "type": "integer",
          "minimum": 1,
          "description": "规格修订号，单调递增（§11 plan_revisions.spec_revision）"
        },
        "intentAuthorizationId": {
          "type": "string",
          "minLength": 1,
          "description": "关联 IntentAuthorization ID（§11 plan_revisions.intent_authorization_id）"
        },
        "dagVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "DAG 版本号（§11 plan_revisions.dag_version）"
        },
        "nodeCapabilityMapVersion": {
          "type": "string",
          "minLength": 1,
          "description": "node→capability 映射版本（§11 plan_revisions.node_capability_map_version）"
        },
        "stageCapabilityMapVersion": {
          "type": "string",
          "minLength": 1,
          "description": "stage→capability 映射版本（§11 plan_revisions.stage_capability_map_version）"
        },
        "semanticPlanHash": {
          "type": "string",
          "minLength": 1,
          "description": "语义计划哈希，跨修订版本稳定"
        },
        "nodes": {
          "type": "array",
          "description": "DAG 节点列表",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logicalNodeId",
              "nodeType",
              "businessPhase",
              "dependencies",
              "hasSideEffect",
              "requiredArtifacts"
            ],
            "properties": {
              "logicalNodeId": {"type": "string", "minLength": 1},
              "nodeType": {
                "type": "string",
                "enum": [
                  "PLAN", "DESIGN_REVIEW", "BOOTSTRAP_REPOSITORY", "IMPLEMENT",
                  "VERIFY", "CODE_REVIEW", "ATTEST_REVIEW", "PUBLISH_PR", "MERGE",
                  "BUILD_ARTIFACT", "DEPLOY_STAGING", "ACCEPT_STAGING",
                  "DEPLOY_PRODUCTION", "ACCEPT_PRODUCTION", "ROLLBACK",
                  "RECONCILE_TARGET", "RESTORE_DRILL"
                ]
              },
              "businessPhase": {"type": "string", "minLength": 1},
              "dependencies": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "hasSideEffect": {"type": "boolean"},
              "requiredArtifacts": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "gate": {"type": "string", "minLength": 1}
            }
          }
        },
        "barriers": {
          "type": "array",
          "description": "阶段屏障列表",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["barrierId", "businessPhase", "nodeIds"],
            "properties": {
              "barrierId": {"type": "string", "minLength": 1},
              "businessPhase": {"type": "string", "minLength": 1},
              "nodeIds": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "stageMaps": {
          "type": "object",
          "additionalProperties": false,
          "description": "target_stage 到节点集合的映射（Master Spec §6.1 权威 target_stage 分类）",
          "properties": {
            "DESIGN_APPROVED": {"type": "array", "items": {"type": "string"}},
            "CODEX_APPROVED": {"type": "array", "items": {"type": "string"}},
            "PR_READY": {"type": "array", "items": {"type": "string"}},
            "MERGED": {"type": "array", "items": {"type": "string"}},
            "STAGING_ACCEPTED": {"type": "array", "items": {"type": "string"}},
            "PRODUCTION_ACCEPTED": {"type": "array", "items": {"type": "string"}}
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stageCapabilityMapPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapVersion", "targetStage", "capabilities"],
      "properties": {
        "mapVersion": {"$ref": "#/$defs/nonEmptyString"},
        "targetStage": {"$ref": "#/$defs/targetStage"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/actionCapability"}
        }
      }
    },
    "nodeCapabilityMapPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapVersion", "rawFileDigest"],
      "properties": {
        "mapVersion": {"$ref": "#/$defs/nonEmptyString"},
        "rawFileDigest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "resourceFingerprintPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeType", "fingerprint"],
      "properties": {
        "nodeType": {"$ref": "#/$defs/nodeType"},
        "fingerprint": {
          "description": "实际对象必须由 node-capability-map.v1.json 对应 nodeType 的内嵌 resourceFingerprintSchema 校验；该嵌入 schema 自己拒绝未知键。"
        }
      }
    },
    "capabilityScopePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "resourceFingerprintDigest"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/actionCapability"}
        },
        "resourceFingerprintDigest": {"$ref": "#/$defs/sha256Digest"},
        "targetBindingDigest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "idempotencyKeyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeType", "actionCapability", "inputBindingsDigest"],
      "properties": {
        "nodeType": {"$ref": "#/$defs/nodeType"},
        "actionCapability": {"$ref": "#/$defs/actionCapability"},
        "inputBindingsDigest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "actionPolicySnapshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeCapabilityMapDigest", "nodeType", "actionCapability", "idempotencyKeyTemplate",
        "completionFact", "authorizationConsumptionPoint", "retryClass"
      ],
      "properties": {
        "nodeCapabilityMapDigest": {"$ref": "#/$defs/sha256Digest"},
        "nodeType": {"$ref": "#/$defs/nodeType"},
        "actionCapability": {"$ref": "#/$defs/actionCapability"},
        "idempotencyKeyTemplate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "hashAlgorithm", "jcsInputFields"],
          "properties": {
            "version": {"const": "factory-action-v1"},
            "hashAlgorithm": {"const": "sha256-jcs-nfc"},
            "jcsInputFields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        "completionFact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["predicateId", "requiredEvidence"],
          "properties": {
            "predicateId": {"$ref": "#/$defs/nonEmptyString"},
            "requiredEvidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        "authorizationConsumptionPoint": {
          "enum": ["before-capability-dispatch", "with-action-started-transaction"]
        },
        "retryClass": {
          "enum": [
            "bounded-no-external-side-effect", "local-fact-before-retry",
            "external-fact-before-retry", "one-shot-cas-reconcile-only"
          ]
        }
      }
    },
    "inputContentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentKind", "mediaType", "byteLength"],
      "properties": {
        "contentKind": {"enum": ["artifact", "evidence", "release-material"]},
        "mediaType": {"$ref": "#/$defs/nonEmptyString"},
        "byteLength": {"type": "integer", "minimum": 0},
        "candidateSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  },
  "snapshotBindings": {
    "IntentAuthorization.requirementDigest": {
      "schemaId": "factory.authorization.intent.requirement.v1",
      "schemaVersion": "1",
      "validator": {"kind": "json-schema", "source": "authorization-snapshot-registry.v1.json#/$defs/intentRequirementPayload"},
      "payloadSchema": {"$ref": "#/$defs/intentRequirementPayload"},
      "payloadKeys": {"required": ["requirementText", "normalizationVersion"], "optional": ["attachmentsDigest"]}
    },
    "IntentAuthorization.repositoryBindingDigest": {
      "schemaId": "factory.authorization.intent.repository-binding.v1",
      "schemaVersion": "1",
      "validator": {"kind": "json-schema", "source": "authorization-snapshot-registry.v1.json#/$defs/repositoryBindingPayload"},
