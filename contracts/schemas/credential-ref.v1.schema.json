{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/contracts/schemas/credential-ref.v1.schema.json",
  "title": "CredentialRef",
  "description": "凭据引用（不含凭据值本身）。后续 Forge/Server/Database Profile 必须 $ref 此类型，不得另建不兼容副本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["credentialId", "credentialType", "profileScope"],
  "properties": {
    "credentialId": {
      "type": "string",
      "minLength": 1,
      "description": "凭据唯一 ID（不含明文值）"
    },
    "credentialType": {
      "type": "string",
      "enum": ["SSH_KEY", "REGISTRY_TOKEN", "API_KEY", "GITHUB_APP", "FACTORY_PROFILE_TOKEN"],
      "description": "凭据类型"
    },
    "profileScope": {
      "type": "string",
      "minLength": 1,
      "description": "凭据所属 D-backed 隔离 profile 作用域"
    },
    "resourceFingerprint": {
      "type": "string",
      "minLength": 1,
      "description": "绑定凭据的资源指纹（如 host-key、repository ID）"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "凭据绝对过期时间（ISO 8601）"
    }
  }
}
