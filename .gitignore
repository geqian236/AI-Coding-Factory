# 本项目所有可控数据均应保存在 D 盘项目根目录下，并避免运行产物进入 Git。
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Rust / 构建产物
node_modules/
dist/
build/
target/
coverage/

# 本地运行数据
logs/*
!logs/.gitkeep
data/runtime/
data/backups/
artifacts/
transcripts/
crash-dumps/
tmp/
.tmp/

# 本地设计预览和工作区
.superpowers/
.worktrees/
worktrees/

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Claude Code / workflow 产物（会话级，不入库）
.claude/
.tmp_*.py

# Spike 运行时产物（GPT 第五轮 item 2：phase0-acceptance.ps1 每轮真实执行 wrapper
# 重新生成 receipt.json 并按 runStart 校验新鲜度；receipt 因此是可再生运行时
# artifact，不入库——提交它会使"每轮统一重放"退化成读陈旧回执，且弄脏树破坏
# cleanTree 通过条件。spike 源码（*.rs/*.py/package.json/*.spec.ts）仍入库。）
tools/compat-probes/**/receipt.json
tools/compat-probes/**/_*_stderr.log
tools/compat-probes/**/_*_stdout.log
tools/compat-probes/**/_server_*.log
tools/compat-probes/**/_broker_*.log
tools/compat-probes/**/_child_*.log
tools/compat-probes/**/client_receipt.json
tools/compat-probes/**/server_receipt.json
tools/compat-probes/**/probe_tmp/
# 探针脚手架生成器（本地一次性工具，非入库源码）
tools/compat-probes/_gen_ps1.py
tools/compat-probes/_gen_spikes.py

# Phase 0 验收总回执（phase0-acceptance.ps1 每轮从干净树重新生成，绑定候选 SHA；
# 是可再生运行时 artifact，不入库——提交它会造成 cleanTree 声明与实际树状态循环失配）
.phase0-acceptance-receipt.json
