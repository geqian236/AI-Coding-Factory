{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.local/contracts/schemas/plan-revision.v1.schema.json",
  "title": "PlanRevision",
  "description": "计划修订版本，包含 DAG 节点、barrier、stage 映射和谱系信息。",
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["planRevisionId", "taskId", "specRevision", "intentAuthorizationId", "semanticPlanHash", "planRevisionDigest", "dagVersion", "nodeCapabilityMapVersion", "stageCapabilityMapVersion", "nodes", "barriers", "stageMaps", "createdAt"],
  "properties": {
    "planRevisionId": {
      "type": "string",
      "minLength": 1,
      "description": "本修订版本唯一 ID"
    },
    "parentRevisionId": {
      "type": "string",
      "minLength": 1,
      "description": "父修订版本 ID（范围内重规划时设置）"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "所属任务 ID（§11 plan_revisions.task_id）"
    },
    "specRevision": {
      "type": "integer",
      "minimum": 1,
      "description": "规格修订号，单调递增（§11 plan_revisions.spec_revision）"
    },
    "intentAuthorizationId": {
      "type": "string",
      "minLength": 1,
      "description": "关联 IntentAuthorization ID（§11 plan_revisions.intent_authorization_id）"
    },
    "dagVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "DAG 版本号（§11 plan_revisions.dag_version）"
    },
    "nodeCapabilityMapVersion": {
      "type": "string",
      "minLength": 1,
      "description": "node→capability 映射版本（§11 plan_revisions.node_capability_map_version）"
    },
    "stageCapabilityMapVersion": {
      "type": "string",
      "minLength": 1,
      "description": "stage→capability 映射版本（§11 plan_revisions.stage_capability_map_version）"
    },
    "semanticPlanHash": {
      "type": "string",
      "allOf": [{"$ref": "#/$defs/sha256Digest"}],
      "description": "语义计划哈希，跨修订版本稳定"
    },
    "planRevisionDigest": {
      "type": "string",
      "allOf": [{"$ref": "#/$defs/sha256Digest"}],
      "description": "本修订版本内容摘要"
    },
    "signature": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "description": "DAG 工作节点列表",
      "allOf": [
        {
          "items": [
            {
              "type": "object",
              "required": ["nodeType", "businessPhase"],
              "properties": {
                "nodeType": {"const": "PLAN"},
                "businessPhase": {"const": "PLANNING"}
              }
            }
          ]
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalNodeId",
          "businessPhase",
          "barrierOrdinal",
          "nodeType",
          "required",
          "dependsOn",
          "sideEffectClass",
          "requiredArtifacts",
          "successPredicateId",
          "timeoutMs",
          "retryPolicyId"
        ],
        "allOf": [
          {"not": {"properties": {"nodeType": {"const": "BOOTSTRAP_REPOSITORY"}}, "required": ["nodeType"]}},
          {"not": {"properties": {"businessPhase": {"enum": ["BOOTSTRAPPING", "BOOTSTRAPPING_REPOSITORY"]}}, "required": ["businessPhase"]}}
        ],
        "properties": {
          "logicalNodeId": {"type": "string", "minLength": 1},
          "businessPhase": {
            "type": "string",
            "enum": [
              "PLANNING", "DESIGN_REVIEWING", "PREPARING_WORKSPACE",
              "IMPLEMENTING", "VERIFYING", "CODE_REVIEWING", "PUBLISHING_PR",
              "MERGING", "BUILDING_ARTIFACT", "DEPLOYING_STAGING",
              "ACCEPTING_STAGING", "DEPLOYING_PRODUCTION", "ACCEPTING_PRODUCTION",
              "ROLLING_BACK", "FINALIZING"
            ]
          },
          "barrierOrdinal": {"type": "integer", "minimum": 0},
          "nodeType": {
            "type": "string",
            "enum": [
              "PLAN", "DESIGN_REVIEW", "BOOTSTRAP_REPOSITORY", "IMPLEMENT",
              "VERIFY", "CODE_REVIEW", "ATTEST_REVIEW", "PUBLISH_PR", "MERGE",
              "BUILD_ARTIFACT", "DEPLOY_STAGING", "ACCEPT_STAGING",
              "DEPLOY_PRODUCTION", "ACCEPT_PRODUCTION", "ROLLBACK",
              "RECONCILE_TARGET", "RESTORE_DRILL"
            ]
          },
          "required": {"type": "boolean"},
          "dependsOn": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "sideEffectClass": {"type": "string", "minLength": 1},
          "requiredArtifacts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "successPredicateId": {"type": "string", "minLength": 1},
          "timeoutMs": {"type": "integer", "minimum": 1},
          "retryPolicyId": {"type": "string", "minLength": 1}
        }
      }
    },
    "barriers": {
      "type": "array",
      "minItems": 1,
      "description": "阶段屏障列表",
      "allOf": [
        {
          "items": [
            {
              "type": "object",
              "required": ["businessPhase"],
              "properties": {"businessPhase": {"const": "PLANNING"}}
            }
          ]
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "businessPhase",
          "barrierOrdinal",
          "requiredNodeIds",
          "settleTimeoutMs",
          "passPredicateId"
        ],
        "not": {"properties": {"businessPhase": {"enum": ["BOOTSTRAPPING", "BOOTSTRAPPING_REPOSITORY"]}}, "required": ["businessPhase"]},
        "properties": {
          "businessPhase": {
            "type": "string",
            "enum": [
              "PLANNING", "DESIGN_REVIEWING", "PREPARING_WORKSPACE",
              "IMPLEMENTING", "VERIFYING", "CODE_REVIEWING", "PUBLISHING_PR",
              "MERGING", "BUILDING_ARTIFACT", "DEPLOYING_STAGING",
              "ACCEPTING_STAGING", "DEPLOYING_PRODUCTION", "ACCEPTING_PRODUCTION",
              "ROLLING_BACK", "FINALIZING"
            ]
          },
          "barrierOrdinal": {"type": "integer", "minimum": 0},
          "requiredNodeIds": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "settleTimeoutMs": {"type": "integer", "minimum": 1},
          "passPredicateId": {"type": "string", "minLength": 1}
        }
      }
    },
    "stageMaps": {
      "type": "object",
      "additionalProperties": false,
      "description": "target_stage 到节点集合的映射（Master Spec §6.1 权威 target_stage 分类）",
      "properties": {
        "DESIGN_APPROVED":     {"type": "array", "items": {"type": "string"}},
        "CODEX_APPROVED":      {"type": "array", "items": {"type": "string"}},
        "PR_READY":            {"type": "array", "items": {"type": "string"}},
        "MERGED":              {"type": "array", "items": {"type": "string"}},
        "STAGING_ACCEPTED":    {"type": "array", "items": {"type": "string"}},
        "PRODUCTION_ACCEPTED": {"type": "array", "items": {"type": "string"}}
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
